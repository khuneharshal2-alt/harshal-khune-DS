#include<iostream>
using namespace std;

int main()
{
    int token[5];
    int top=-1;

    cout<<"enter the 5 tokens"<<endl;
    for(int i=0;i<5;i++)
    {
        cin>>token[++top];
    }

    while(top>=0)
    {
        cout<<"token is processing "<<token[top]<<endl;
        top--;
    }
    return 0;
}
